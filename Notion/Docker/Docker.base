# Docker

filters:
  and:
    - note["base"] == link("Docker.base")
properties:
  file.name:
    displayName: 페이지
  최종 편집 일시:
    displayName: 최종 편집 일시
  태그:
    displayName: 태그
  인증:
    displayName: 인증
  소유자:
    displayName: 소유자
views:
  - type: table
    name: Table View
    order:
      - file.name
      - 최종 편집 일시
      - 태그
      - 인증
      - 소유자
